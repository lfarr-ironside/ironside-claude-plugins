# Copia este archivo a .env y completa los valores. NUNCA commitees .env.
#
# AZURE_SUBSCRIPTION_ID es la única variable que el Azure MCP Server lee
# directamente. Las demás son referencias para que recuerdes qué mencionar
# en tus prompts a Claude (ej: "consulta la tabla X en mi servidor my-pg-server
# del resource group rg-data").

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# --- Referencias para usar en prompts (no son leídas por el server) ---
PG_RESOURCE_GROUP=rg-data-prod
PG_SERVER_NAME=ironside-pg-prod
PG_DATABASE=analytics
